{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "ENV": "dev",
        "EXPO_PUBLIC_ENV": "dev",
        "EXPO_PUBLIC_API_BASE_URL": "https://recipestorage2026.shop"
      }
    },
    "prod": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "ENV": "prod",
        "EXPO_PUBLIC_ENV": "prod",
        "EXPO_PUBLIC_API_BASE_URL": "https://recipestorage2026.shop"
      }
    },
    "production": {
      "extends": "prod"
    }
  }
}
