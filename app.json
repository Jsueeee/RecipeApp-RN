{
  "expo": {
    "name": "레시피 저장소",
    "slug": "RecipeApp",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recipe.android.recipeapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "S7TUXRR3LP",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.recipe.android.recipeapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "3cb89516c27c020802d2b85534cda074",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "expo-secure-store",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      ["react-native-edge-to-edge"],
      ["@react-native-google-signin/google-signin"],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "com.recipe.android.recipeapp"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#9FE5D3",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#9FE5D3"
          },
          "imageWidth": 200
        }
      ],
      ["expo-apple-authentication"],
      "react-native-google-mobile-ads",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2611426405819679~9602354001",
          "iosAppId": "ca-app-pub-2611426405819679~6618341289"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/pretendard_regular.otf",
            "./assets/fonts/pretendard_medium.otf",
            "./assets/fonts/pretendard_semi_bold.otf",
            "./assets/fonts/pretendard_bold.otf",
            "./assets/fonts/cafe_24_ssurround.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
