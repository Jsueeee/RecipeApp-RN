{
  "name": "recipeapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "ENV=dev expo start",
    "prod": "node scripts/with-env.js .env.prod expo start",
    "android:dev": "ENV=dev expo run:android",
    "android:prod": "node scripts/with-env.js .env.prod expo run:android --variant release",
    "ios:dev": "ENV=dev expo run:ios",
    "ios:prod": "node scripts/with-env.js .env.prod expo run:ios --configuration Release",
    "android:release": "node scripts/with-env.js .env.prod expo run:android --variant release",
    "android:bundle": "node scripts/with-env.js .env.prod ./android/gradlew -p android bundleRelease",
    "ios:release": "node scripts/with-env.js .env.prod expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^14.0.0",
    "@react-native-kakao/core": "^2.3.0",
    "@react-native-kakao/user": "^2.3.0",
    "@react-native-seoul/naver-login": "^4.1.2",
    "@react-navigation/native": "^7.0.14",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-query-devtools": "^5.69.0",
    "axios": "^1.8.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.26",
    "expo-apple-authentication": "~55.0.13",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.16",
    "form-data": "^4.0.4",
    "i18n-js": "^4.5.1",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-edge-to-edge": "^1.5.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^16.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-ui-datepicker": "^3.1.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.17",
    "toastify-react-native": "^7.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@tanstack/eslint-plugin-query": "^5.68.0",
    "@types/react": "~19.2.10",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.18",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
