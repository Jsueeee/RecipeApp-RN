# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# Xcode Archive does not go through npm scripts, so it would otherwise miss
# `.env.prod`. Load production public env for Release/Profile builds and local
# env for Debug builds.
if [ -n "${PODS_ROOT:-}" ]; then
  RECIPEAPP_PROJECT_ROOT="$PODS_ROOT/../.."

  case "${ENV:-}:${CONFIGURATION:-}" in
    prod:*|*:Release*|*:Profile*)
      RECIPEAPP_ENV_FILE="$RECIPEAPP_PROJECT_ROOT/.env.prod"
      ;;
    *)
      RECIPEAPP_ENV_FILE="$RECIPEAPP_PROJECT_ROOT/.env"
      ;;
  esac

  if [ -f "$RECIPEAPP_PROJECT_ROOT/scripts/xcode-load-env.sh" ]; then
    . "$RECIPEAPP_PROJECT_ROOT/scripts/xcode-load-env.sh" "$RECIPEAPP_ENV_FILE"
  fi
fi
